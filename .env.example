# Integrazione Meta Lead Ads — SOLO NOMI. I valori vanno impostati come variabili d'ambiente su Vercel
# (Settings → Environment Variables), mai nel codice, nei commit o nei log. Vedi docs/META_LEADS.md.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ID=
META_GRAPH_API_VERSION=
META_ALLOWED_FORM_IDS=

# Opzionali
META_DEFAULT_BRAND=
META_FORM_BRANDS=
META_LOCAL_INGEST=
META_INTERNAL_SECRET=
META_RETRY_SECRET=
META_DOWNSTREAMS=
# Per ogni nome in META_DOWNSTREAMS (maiuscolo, caratteri non alfanumerici → _):
# META_DOWNSTREAM_<NOME>_URL=
# META_DOWNSTREAM_<NOME>_SECRET=

# --- Gateway Meta / fan-out (solo NOMI; i valori vanno inseriti a mano su Vercel) ---
# META_SCHEDULER_SECRET=            # >= 32 caratteri (Bearer per /api/internal/tick)
# CRON_SECRET=                      # alternativa: Vercel Cron (piano Pro)
# QSTASH_CURRENT_SIGNING_KEY=       # alternativa: Upstash QStash
# QSTASH_NEXT_SIGNING_KEY=
# META_DOWNSTREAMS=crm-a,crm-b
# META_DOWNSTREAM_CRM_A_URL=
# META_DOWNSTREAM_CRM_A_SECRET=     # >= 32 caratteri, DISTINTO per ogni CRM
# META_DOWNSTREAM_CRM_A_MODE=shadow # shadow (default) | live
# META_INTERNAL_SECRET=             # CRM ricevente: segreto di questo CRM
# META_INTERNAL_MODE=shadow         # CRM ricevente: shadow (default) | live
# META_INTERNAL_SECRET_NEXT=        # solo durante la rotazione del segreto
# META_LOCAL_INGEST=false           # gateway: non crea lead locali
