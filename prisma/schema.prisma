generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ruolo utente: COMMERCIALE | TELEFONISTA | POSATORE | AMMINISTRATIVO | AMMINISTRATORE
// Fase lead: NUOVO | CONTATTATO | APPUNTAMENTO_FISSATO | NON_RISPONDE | NON_INTERESSATO
// Tipo appuntamento: COMMERCIALE | RILIEVO_TECNICO
// Stato appuntamento: PROGRAMMATO | CONFERMATO | COMPLETATO | ANNULLATO
// Stato preventivo: APERTO | ACCETTATO | SCADUTO | ANNULLATO
// Canale promemoria: EMAIL | WHATSAPP
// (SQLite non supporta enum nativi: questi valori sono validati in app/lib/enums.ts)

model Brand {
  id        String     @id @default(cuid())
  nome      String     @unique
  clienti   Cliente[]
  lead      Lead[]
  prodotti  Prodotto[]
  preventivi Preventivo[]
  optionali Optional[]
  modelli   ModelloProdotto[]
  utentiAutorizzati Utente[] @relation("PermessoListino")
  solarisComponenti SolarisComponente[]
  leadSimulazioni   LeadSimulazione[]
}

model Utente {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  ruolo         String
  // Credenziali di accesso al CRM. Username nullable per compatibilità con gli utenti creati
  // prima dell'introduzione del login (vanno attivati impostando username+password da Impostazioni).
  // Senza passwordHash l'utente non può accedere.
  username      String?  @unique
  passwordHash  String?
  // Telefono di contatto mostrato nella stampa dell'offerta come riferimento commerciale.
  telefono      String?
  // Se true, al login successivo l'utente deve impostare una nuova password (es. dopo un reset
  // amministratore con password temporanea).
  mustChangePassword Boolean @default(true)
  createdAt     DateTime @default(now())
  leadAssegnati Lead[]
  appuntamenti  Appuntamento[]
  preventivi    Preventivo[]
  attivita      Attivita[]
  obiettivi     Obiettivo[]
  clientiResponsabile Cliente[] @relation("ResponsabileCliente")
  // Listini/brand per cui questo utente è autorizzato a operare (assegnati dall'amministratore)
  brandAutorizzati Brand[] @relation("PermessoListino")
  solarisProgetti  SolarisProgetto[]
}

model Lead {
  id          String    @id @default(cuid())
  nome        String
  telefono    String?
  email       String?
  fonte       String    @default("facebook")
  fase        String    @default("NUOVO")
  note        String?
  brand       Brand     @relation(fields: [brandId], references: [id])
  brandId     String
  telefonista Utente?   @relation(fields: [telefonistaId], references: [id])
  telefonistaId String?
  clienteGenerato Cliente?
  createdAt   DateTime  @default(now())
}

model Cliente {
  id         String    @id @default(cuid())
  nome       String
  telefono   String?
  email      String?
  indirizzo  String?
  cap        String?
  comune     String?
  provincia  String?
  paese      String    @default("IT")
  brand      Brand     @relation(fields: [brandId], references: [id])
  brandId    String
  leadOrigine Lead?    @relation(fields: [leadOrigineId], references: [id])
  leadOrigineId String? @unique
  // Utente "proprietario" del cliente ai fini della visibilità dati per ruolo (chi lo ha creato,
  // riassegnabile dall'amministratore). Nullable per compatibilità con i clienti pre-esistenti.
  responsabile   Utente? @relation("ResponsabileCliente", fields: [responsabileId], references: [id])
  responsabileId String?
  appuntamenti    Appuntamento[]
  preventivi      Preventivo[]
  attivita        Attivita[]
  solarisProgetti SolarisProgetto[]
  createdAt       DateTime  @default(now())
}

model Appuntamento {
  id        String   @id @default(cuid())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String
  utente    Utente   @relation(fields: [utenteId], references: [id])
  utenteId  String
  tipo      String   @default("COMMERCIALE")
  dataOra   DateTime
  stato     String   @default("PROGRAMMATO")
  createdAt DateTime @default(now())
}

model Prodotto {
  id         String   @id @default(cuid())
  brand      Brand    @relation(fields: [brandId], references: [id])
  brandId    String
  tipologia  String
  descrizione String?
  colore     String
  altezzaMm  Int
  larghezzaMm Int
  prezzoBase Float
  coefficienteRicarico Float?
  righe      RigaPreventivo[]

  @@unique([brandId, tipologia, colore, altezzaMm, larghezzaMm])
}

model Configurazione {
  id     String @id @default(cuid())
  chiave String @unique
  valore String
}

model Preventivo {
  id           String          @id @default(cuid())
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  clienteId    String
  brand        Brand           @relation(fields: [brandId], references: [id])
  brandId      String
  commerciale  Utente          @relation(fields: [commercialeId], references: [id])
  commercialeId String
  stato        String          @default("APERTO")
  // Numero offerta progressivo per brand+anno (es. 1, 2, 3... resettato ogni anno solare per ciascun brand).
  // Nullable per compatibilità con i preventivi creati prima dell'introduzione di questo campo.
  numeroOfferta Int?
  totaleNetto  Float           @default(0)
  aliquotaIva  Float           @default(22)
  totaleIva    Float           @default(0)
  // Oggetto/titolo dell'offerta (es. "Zanzarriere pergola scorrevoli con rete acciaio")
  oggetto      String?
  // Sconto percentuale applicato sull'imponibile lordo (somma righe) prima del calcolo IVA;
  // totaleNetto memorizza già l'imponibile SCONTATO
  scontoPercentuale Float      @default(0)
  // Testo libero per la stampa dell'offerta (condizioni di fornitura/vendita specifiche di questa offerta)
  condizioniPagamento String?
  condizioniConsegna  String?
  // Immagine (URL) mostrata in cima alla prima pagina della stampa offerta, es. foto del progetto o rendering
  immagineCopertinaUrl String?
  righe        RigaPreventivo[]
  // Sezioni/stanze in cui il commerciale può raggruppare le righe (es. "Cucina",
  // "Camera 1"...) per organizzare preventivi con molti articoli misti (finestre,
  // tapparelle, zanzariere...) invece di un unico elenco piatto. Le righe senza
  // sezioneId restano nell'elenco "senza sezione" in cima.
  sezioni      SezionePreventivo[]
  promemoria      PromemoriaInviato[]
  progetto        Progetto?
  solarisProgetto SolarisProgetto?
  createdAt       DateTime        @default(now())
  scadenza        DateTime?
}

model RigaPreventivo {
  id            String     @id @default(cuid())
  preventivo    Preventivo @relation(fields: [preventivoId], references: [id])
  preventivoId  String
  // prodottoId è opzionale per permettere righe di solo testo libero (vedi testoLibero)
  prodotto      Prodotto?  @relation(fields: [prodottoId], references: [id])
  prodottoId    String?
  // Riga senza prodotto collegato: testo libero mostrato al posto della scheda prodotto,
  // sia nell'editor sia in stampa (usato per note, info aggiuntive o motivazione sconto).
  testoLibero   String?
  quantita      Int        @default(1)
  prezzoUnitario Float
  optionalDescrizione String?
  optionalPrezzo Float @default(0)
  mostraDescrizione Boolean @default(true)
  // Misura reale inserita a mano dal commerciale (può differire dalla fascia di prezzo
  // agganciata in prodottoId, che è la fascia più vicina per eccesso nel listino nascosto)
  misuraLarghezza Float?
  misuraAltezza   Float?
  // Testo libero che sovrascrive, solo per questa riga, la descrizione tecnica standard
  // del modello (utile per non ripetere descrizioni identiche o correggerne il testo)
  descrizionePersonalizzata String?
  // Ordinamento manuale (frecce su/giu nell'editor preventivo) fra le righe che
  // condividono la stessa sezione (o fra tutte le righe "senza sezione" se null).
  // Non è garantito univoco/denso finché nessuno riordina: in quel caso l'ordine
  // effettivo resta quello di creazione (vedi orderBy [ordine, id] nella pagina).
  ordine        Int            @default(0)
  sezione       SezionePreventivo? @relation(fields: [sezioneId], references: [id], onDelete: SetNull)
  sezioneId     String?
  optionali     RigaOptional[]
}

// Sezione/stanza di un preventivo (es. "Cucina", "Camera da letto 1") creata a
// mano dal commerciale per raggruppare le righe che vanno in quell'ambiente,
// invece di un unico elenco piatto di finestre/tapparelle/zanzariere ecc.
model SezionePreventivo {
  id           String           @id @default(cuid())
  preventivo   Preventivo       @relation(fields: [preventivoId], references: [id])
  preventivoId String
  nome         String
  // Ordinamento manuale fra le sezioni dello stesso preventivo (frecce su/giu).
  ordine       Int              @default(0)
  righe        RigaPreventivo[]
  createdAt    DateTime         @default(now())
}

model PromemoriaInviato {
  id           String     @id @default(cuid())
  preventivo   Preventivo @relation(fields: [preventivoId], references: [id])
  preventivoId String
  canale       String
  inviatoIl    DateTime   @default(now())
}

model Progetto {
  id                    String     @id @default(cuid())
  preventivo            Preventivo @relation(fields: [preventivoId], references: [id])
  preventivoId          String     @unique
  misureRilievoConfermate String?
  statoOrdineFornitore  String     @default("da_avviare")
  createdAt             DateTime   @default(now())
}

// Categoria optional: STAFFA | TESSUTO | SENSORE | TIMPANO | ALTRO
// tipoPrezzo: FISSO (valore in euro) | PERCENTUALE (valore in % sul prezzo netto della riga)
model Optional {
  id          String   @id @default(cuid())
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  categoria   String
  nome        String
  tipoPrezzo  String   @default("FISSO")
  valore      Float
  unita       String?
  sporgenzaMm Int?
  larghezzaMm Int?
  listino     String?
  note        String?
  // URL immagine rappresentativa (es. per i pannelli di rivestimento a catalogo: Blindati).
  // Facoltativo: molte righe Optional restano senza immagine (accessori, sovrapprezzi, ecc.).
  immagineUrl String?
  // Gruppi merceologici (ModelloProdotto.gruppo) a cui questo optional è applicabile,
  // es. ["PERGOLE", "BIOCLIMATICA"]. Vuoto = nessuna restrizione di gruppo.
  gruppiApplicabili String[] @default([])
  // Finitura/profilo (es. "STD", "STDPLUS", "MICH", "FL" per le zanzariere plissettate)
  // a cui questo optional è vincolato — es. i colori profilo Standard Plus non devono
  // comparire quando si è scelto il modello di finitura Standard. Null = nessuna
  // restrizione di finitura (l'optional compare per qualunque finitura del gruppo).
  finituraApplicabile String?
  righe       RigaOptional[]
}

model RigaOptional {
  id             String         @id @default(cuid())
  riga           RigaPreventivo @relation(fields: [rigaId], references: [id])
  rigaId         String
  optional       Optional       @relation(fields: [optionalId], references: [id])
  optionalId     String
  quantita       Int            @default(1)
  prezzoUnitario Float
  // Slot di scrittura libera: usato per correggere/precisare a mano il codice
  // tessuto esatto scelto dal campionario fisico Tempotest quando quello
  // pre-catalogato in Optional.nome non è affidabile al 100% (vedi task #210).
  nota           String?
}

// tipo attivita: EMAIL | CHIAMATA | NOTA | TASK | APPUNTAMENTO
model Attivita {
  id          String    @id @default(cuid())
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  clienteId   String
  tipo        String
  oggetto     String
  descrizione String?
  dataOra     DateTime  @default(now())
  scadenza    DateTime?
  completata  Boolean   @default(false)
  utente      Utente?   @relation(fields: [utenteId], references: [id])
  utenteId    String?
  createdAt   DateTime  @default(now())
}

// Scheda tecnica condivisa per tutte le varianti dimensionali di una tipologia
// (es. tutte le righe LUCILLA_PARETE_SINGOLA condividono la stessa immagine/descrizione)
model ModelloProdotto {
  id                 String  @id @default(cuid())
  brand              Brand   @relation(fields: [brandId], references: [id])
  brandId            String
  tipologia          String
  immagineUrl        String?
  descrizioneTecnica String?
  famiglia           String?
  gruppo             String?
  // Modalità di calcolo del prezzo per questo modello:
  // - "GRIGLIA" (default): prezzo letto da Prodotto.prezzoBase per la fascia larghezza/altezza più vicina (comportamento storico)
  // - "METRO_LINEARE": prezzo = tariffa al metro lineare (dipendente dalla fascia altezza, righe Prodotto usate solo per la tariffa) x larghezza reale arrotondata
  // - "MQ_CON_MINIMI": prezzo = tariffa fissa al m² (Prodotto.prezzoBase dell'unica riga) x superficie fatturabile (con eventuali minimi di altezza/area)
  modalitaCalcolo    String  @default("GRIGLIA")
  // Parametri del calcolo a formula (usato solo se modalitaCalcolo != "GRIGLIA"), es.
  // {"arrotondamentoCm":5} oppure {"arrotondamentoCm":5,"areaMinimaM2":3,"altezzaMinimaMm":1500}
  parametriCalcolo   Json?

  @@unique([brandId, tipologia])
}

// Obiettivo commerciale periodico (target di vendita), assegnato dall'amministratore
model Obiettivo {
  id            String   @id @default(cuid())
  utente        Utente   @relation(fields: [utenteId], references: [id])
  utenteId      String
  periodo       String   // formato "YYYY-MM"
  importoTarget Float
  note          String?
  createdAt     DateTime @default(now())

  @@unique([utenteId, periodo])
}

// ============ SOLARIS STUDIO — Progettazione Fotovoltaico ============

// Progetto fotovoltaico collegato a un preventivo Solaris.
// stato: BOZZA | INVIATO | ACCETTATO
model SolarisProgetto {
  id            String     @id @default(cuid())
  preventivo    Preventivo @relation(fields: [preventivoId], references: [id])
  preventivoId  String     @unique
  cliente       Cliente    @relation(fields: [clienteId], references: [id])
  clienteId     String
  commerciale   Utente     @relation(fields: [commercialeId], references: [id])
  commercialeId String

  // Step 1 — Casa e consumi
  nomeCliente    String?
  indirizzo      String?
  latitudine     Float?
  longitudine    Float?
  zonaClimatica  String?   // A | B | C | D | E | F
  consumoKwh     Float?
  prezzoEnergia  Float?
  fasciaF1       Float?
  presenzaGiorno Int?      // 0=quasi mai 1=a volte 2=quasi sempre
  quizJson       Json?     // abitudini casa (persone, elettrodomestici, EV, ecc.)

  // Step 2 — Tetto e sole
  orientamento   Int?      // -90 (Est) .. 0 (Sud) .. +90 (Ovest)
  inclinazione   Int?      // gradi 5..45
  numeroPannelli Int?
  batteria       Int?      // kWh accumulo (0/5/10/15)
  panelId        String?   // → SolarisComponente.id
  inverterId     String?   // → SolarisComponente.id

  // Costi (visibili solo a AMMINISTRATORE)
  costoKwp      Float?     // €/kWp (posa + strutture)
  costoBatteria Float?     // €/kWh batteria
  detrazioneFlag Float?    // 0.5 | 0.36 | 0

  // Risultati simulazione (calcolati e cache-ati)
  kwp                Float?
  produzioneStimaKwh Float?
  risparmioAnno1     Float?
  rientroAnni        Float?
  risparmio25anni    Float?
  autonomiaPercent   Float?

  // Foto tetto
  fotoTetto     SolarisFoto[]

  // Firma digitale (Step 4)
  firmaDataUri  String?   @db.Text
  firmatoIl     DateTime?

  // Snapshot completo per riaprire il progetto nello stesso stato (oggetto S del prototipo)
  statoJson     Json?

  stato         String    @default("BOZZA")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Foto del tetto caricate durante la progettazione (data URI, come RilievoAllegato)
// tipo: TETTO | SATELLITARE | SCHEMA
model SolarisFoto {
  id         String          @id @default(cuid())
  progetto   SolarisProgetto @relation(fields: [progettoId], references: [id], onDelete: Cascade)
  progettoId String
  nome       String?
  dataUri    String          @db.Text
  tipo       String          @default("TETTO")
  createdAt  DateTime        @default(now())
}

// Catalogo pannelli e inverter gestito dall'amministratore (sostituisce il catalogo hardcoded
// nel prototipo che usava localStorage). categoria: PANNELLO | INVERTER
model SolarisComponente {
  id            String   @id @default(cuid())
  brand         Brand    @relation(fields: [brandId], references: [id])
  brandId       String
  categoria     String   // PANNELLO | INVERTER
  nome          String
  potenzaW      Float    // Wp per i pannelli, W per gli inverter
  misureJson    Json?    // {w: 1.134, h: 1.762} per i pannelli (metri)
  prezzoVendita Float
  costoAcquisto Float
  ibrido        Boolean  @default(false) // true = inverter ibrido (gestisce batteria)
  attivo        Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())

  @@unique([brandId, categoria, nome])
}

// Lead acquisito dalla pagina pubblica /simula (simulatore fotovoltaico su solarisfotovoltaico.com)
// stato: NUOVO | CONTATTATO | CONVERTITO | NON_INTERESSATO
model LeadSimulazione {
  id              String   @id @default(cuid())
  brand           Brand    @relation(fields: [brandId], references: [id])
  brandId         String
  nome            String
  telefono        String?
  email           String?
  consensoPrivacy Boolean  @default(false)

  // Dati della simulazione (acquisiti dal form)
  localita         String?
  latitudine       Float?
  longitudine      Float?
  consumoKwh       Float?
  prezzoEnergia    Float?
  orientamento     Int?
  inclinazione     Int?
  batteria         Int?    // kWh
  kwp              Float?
  risparmioStimato Float?
  rientroAnni      Float?

  stato            String  @default("NUOVO")
  fonte            String  @default("simulatore_web")
  // Collegamento al Lead CRM se convertito
  leadGeneratoId   String? @unique

  // Snapshot completo della simulazione al momento dell'invio
  simulazioneJson  Json?
  createdAt        DateTime @default(now())
}
